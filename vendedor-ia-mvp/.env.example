# OPCIONAL. O jeito recomendado é o mesmo do classificar_ligacoes_diario.py:
#   python iniciar.py   -> usa a variável API_KEY ou pede a chave numa janela (não salva em disco).
# Se preferir arquivo: copie para .env (nunca versione o .env nem coloque a chave neste arquivo).
LLM_API_KEY=sua_chave
# Padrão já é o llm-gate não produtivo; com ou sem /chat/completions
LLM_BASE_URL=https://llm-gate-np.localiza.dev/llm-gate/v2/chat/completions
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=60
# llm-gate usa o cabeçalho 'api_key' (padrão). Para outro gateway: LLM_AUTH_HEADER=Authorization (vira Bearer)
LLM_AUTH_HEADER=api_key
# gpt-5.x: raciocínio é cobrado como saída; "minimal" mantém rápido e barato. Vazio = não envia.
LLM_REASONING_EFFORT=minimal
# Opcional: caminho do certificado corporativo (.pem) se der erro de SSL
LLM_CA_BUNDLE=
# Estimativa de custo (US$ por 1 mil tokens) quando o gate não devolver cost.token.total
LLM_COST_PER_1K_IN=0.00075
LLM_COST_PER_1K_OUT=0.0045
# Ferramentas: auto (usa 'tools' nativo; se o gate recusar, passa sozinho para o protocolo JSON) | native | json
LLM_TOOLS=auto
# Áudio (transcrição pelo gate). Padrão: mesma base do chat em /audio/transcriptions
LLM_STT_MODEL=gpt-4o-mini-transcribe
LLM_STT_URL=
# llm = exige o GPT (falha -> mensagem de contingência) | auto = GPT se houver chave | mock = nunca chama
LLM_MODE=llm

# Abertura da Fernanda: 1 = atual (cadastro como afirmação) | 2 = SPIN (cadastro como hipótese a confirmar)
FERNANDA_ABERTURA=1
