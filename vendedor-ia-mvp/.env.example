# Copie para .env e preencha. NUNCA versione o .env nem coloque a chave neste arquivo.
# Valores sem aspas (aspas também são aceitas).
LLM_API_KEY=sua_chave
# URL base ou completa (com ou sem /chat/completions)
LLM_BASE_URL=https://endpoint-homologado/v2/chat/completions
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=60
# Cabeçalho da chave. Padrão: Authorization: Bearer <chave>.
# Ex. para gateways: LLM_AUTH_HEADER=api-key (sem prefixo) ou x-api-key
LLM_AUTH_HEADER=Authorization
# Modelos gpt-5.x: raciocínio é cobrado como saída; "minimal" mantém rápido e barato. Vazio = não envia.
LLM_REASONING_EFFORT=minimal
# Opcional: caminho do certificado corporativo (.pem) se der erro de SSL
LLM_CA_BUNDLE=
# Custo por 1 mil tokens em US$ (gpt-5.4-mini: 0,75 / 4,50 por milhão) — usado no painel de métricas
LLM_COST_PER_1K_IN=0.00075
LLM_COST_PER_1K_OUT=0.0045
# auto = usa o LLM se houver chave (falha cai no template, com erro na auditoria)
# mock = nunca chama o LLM | llm = exige o LLM (falha -> mensagem de contingência)
LLM_MODE=llm
