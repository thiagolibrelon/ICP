# Copie para .env e preencha. NUNCA versione o .env.
LLM_API_KEY=sua_chave
LLM_BASE_URL=https://endpoint-homologado
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=60
# auto = usa o LLM se houver chave, senão o vendedor determinístico (offline)
# mock = nunca chama o LLM | llm = exige o LLM (erro -> mensagem de contingência)
LLM_MODE=auto
